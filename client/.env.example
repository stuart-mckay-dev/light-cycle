# Copy to `client/.env` and fill in. Never commit the real file.

# Mapbox PUBLIC token (pk.…). Scope it to styles:read + tiles:read only.
# The map-matching secret key (sk.…) belongs on the server at Goalpost 3 — never here.
VITE_MAPBOX_PUBLIC_TOKEN=pk.ey...

# Goalpost 2+ only. Unused while the game is client-side.
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
